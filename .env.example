# ==========================================
# CONFIGURAÇÕES DO SERVIÇO DE AUDITORIA
# ==========================================

# Google Gemini API (gemini-2.0-flash ou gemini-2.5-flash)
GEMINI_API_KEY=sua_gemini_api_key_aqui
GEMINI_MODEL=gemini-2.0-flash

# Evolution API (WhatsApp)
EVOLUTION_API_URL=http://localhost:8080
EVOLUTION_API_KEY=audit_lojas_secret_2026
EVOLUTION_INSTANCE_NAME=conveniencia

# Diretoria (WhatsApp para alertas executivos e fechamento)
# Formato: DDI + DDD + Número (exemplo: 5511999990000)
DIRECTOR_PHONE=5511999990000

# Banco de dados SQLite local assíncrono
DATABASE_URL=sqlite+aiosqlite:///./app.db

# Configurações do Servidor FastAPI
PORT=8000
HOST=0.0.0.0
DEBUG=True
